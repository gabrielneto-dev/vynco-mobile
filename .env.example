# Copie para .env e preencha. Nunca versione o .env.
OPENROUTER_API_KEY=

# Texto (planejar/criar/adaptar/revisar/analisar). Qualquer modelo do OpenRouter com structured outputs.
MODELO_TEXTO=anthropic/claude-sonnet-5.5

# Imagem (Nano Banana):
#   google/gemini-3.1-flash-image  -> Nano Banana 2 (padrão: bom custo/qualidade)
#   google/gemini-3-pro-image      -> Nano Banana Pro (mais qualidade, texto na imagem melhor, ~2x o custo)
#   google/gemini-2.5-flash-image  -> Nano Banana original (mais barato)
MODELO_IMAGEM=google/gemini-3.1-flash-image

# Opcionais
# OPENROUTER_APP_NOME=Agente de Conteudo iPhones
# OPENROUTER_APP_URL=http://localhost
# MAX_TOKENS=16000
# TIMEOUT_S=180
# DIR_SAIDA=saida
